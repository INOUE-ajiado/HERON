# docker compose 用の設定例。
# 使うときは `.env` にコピーして値を書き換えてください（.env は Git 管理外）。

# --- データベース ---
DB_USER=heron
DB_PASSWORD=change_me_in_production
DB_NAME=heron

# ホスト側に公開する PostgreSQL のポート。
# 既存の PostgreSQL が 5432 を使っていても衝突しないよう既定は 55432。
DB_HOST_PORT=55432

# --- 認証 ---
# 本番では必ずランダムな長い文字列に変更してください。
# 生成例 (PowerShell):
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=heron-dev-secret-change-me

# --- 初期データ ---
# デモ用アカウント・機材を投入するかどうか。実運用では false。
SEED_DEMO=true

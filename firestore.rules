rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ログイン済み (Google 認証) かどうか
    function signedIn() {
      return request.auth != null;
    }

    // 許可された社内メンバー (@ajiado.co.jp または test_members ホワイトリスト登録済み) かどうか
    function isAllowedUser() {
      return signedIn() && request.auth.token.email != null && (
        request.auth.token.email.lower().matches('.*@ajiado[.]co[.]jp$') ||
        request.auth.token.email.lower() in [
          'inoue@ajiado.co.jp',
          'admin@heron.app',
          'nakamura@ajiado.co.jp',
          'matsuyama@ajiado.co.jp',
          'inoue.cq.jwl@gmail.com',
          'a_yamada@ajiado.co.jp',
          'shimako@ajiado.co.jp'
        ] ||
        exists(/databases/$(database)/documents/test_members/$(request.auth.token.email.lower())) ||
        exists(/databases/$(database)/documents/test_members/$(request.auth.token.email))
      );
    }

    // システム管理者かどうか（オーナーメールアドレス または managed_users の role == 'admin'）
    function isSystemAdmin() {
      return isAllowedUser() && (
        request.auth.token.email.lower() in [
          'inoue@ajiado.co.jp',
          'admin@heron.app',
          'inoue.cq.jwl@gmail.com'
        ] || (
          exists(/databases/$(database)/documents/managed_users/$(request.auth.token.email.lower())) &&
          get(/databases/$(database)/documents/managed_users/$(request.auth.token.email.lower())).data.status == 'active' &&
          get(/databases/$(database)/documents/managed_users/$(request.auth.token.email.lower())).data.role == 'admin'
        )
      );
    }

    // 機材・アカウント管理者以上かどうか
    function isAssetManagerOrAdmin() {
      return isSystemAdmin() || (
        isAllowedUser() && (
          request.auth.token.email.lower() in [
            'nakamura@ajiado.co.jp'
          ] || (
            exists(/databases/$(database)/documents/managed_users/$(request.auth.token.email.lower())) &&
            get(/databases/$(database)/documents/managed_users/$(request.auth.token.email.lower())).data.status == 'active' &&
            get(/databases/$(database)/documents/managed_users/$(request.auth.token.email.lower())).data.role == 'asset_manager'
          )
        )
      );
    }

    // テストメンバー (ホワイトリスト) — 閲覧・初期マイグレーションは許可メンバー、変更・削除はシステム管理者のみ
    match /test_members/{email} {
      allow read, create: if isAllowedUser();
      allow update, delete: if isSystemAdmin();
    }

    // アクセス権限管理ユーザー (RBAC) — 変更・削除はシステム管理者のみ（自己権限昇格の防止）
    match /managed_users/{email} {
      allow read, create: if isAllowedUser();
      allow update, delete: if isSystemAdmin();
    }

    // 機材
    match /equipments/{equipmentId} {
      allow read, write: if isAllowedUser();
    }

    // 操作ログ (監査履歴)。改ざん防止のため追記のみ許可し、更新・削除は禁止。
    match /logs/{logId} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser();
      allow update, delete: if false;
    }

    // 保管場所
    match /locations/{locationId} {
      allow read, write: if isAllowedUser();
    }

    // 利用者
    match /users/{userId} {
      allow read, write: if isAllowedUser();
    }

    // マスタ (部署・カテゴリ・棚)
    match /departments/{code} {
      allow read, write: if isAllowedUser();
    }
    match /categories/{code} {
      allow read, write: if isAllowedUser();
    }
    match /shelves/{code} {
      allow read, write: if isAllowedUser();
    }

    // バージョン履歴（リリース内容の記録）
    match /versions/{version} {
      allow read, write: if isAllowedUser();
    }

    // 採番カウンタ・システム設定（権限マトリクス等の更新はシステム管理者のみ許可し権限昇格を防止）
    match /counters/{name} {
      allow read, write: if isAllowedUser();
    }
    match /system/{docId} {
      allow read, create: if isAllowedUser();
      allow update, delete: if isSystemAdmin();
    }

    // ソフトウェア・ライセンス＆アカウント台帳（更新・削除は機材・アカウント管理者以上のみ）
    match /licenses/{licenseId} {
      allow read, create: if isAllowedUser();
      allow update, delete: if isAssetManagerOrAdmin();
    }

    // 上記以外はすべて遮断
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
